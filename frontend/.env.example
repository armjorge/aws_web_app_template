# --- App ---
VITE_APP_NAME=AWS Web App Template
VITE_ENVIRONMENT=local

# --- API ---
# Local: http://localhost:8000
# Deployed: value of tofu output api_endpoint
VITE_API_BASE_URL=http://localhost:8000

# --- AWS Cognito (from tofu output) ---
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_USER_POOL_CLIENT_ID=
# Hosted UI domain prefix from tofu output cognito_hosted_ui_domain
VITE_COGNITO_DOMAIN=

# --- Feature flags ---
VITE_ENABLE_AUTH=true
# Set true after configuring google_client_id / google_client_secret in infra
VITE_ENABLE_GOOGLE_AUTH=false
VITE_ENABLE_ANALYTICS=true

# --- PostHog (required for web event tracking) ---
# Project API key from https://app.posthog.com → Project settings
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Optional session replay (increases volume / cost)
VITE_POSTHOG_SESSION_RECORDING=false

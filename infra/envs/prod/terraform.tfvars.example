aws_region   = "us-east-1"
project_name = "aws-web-app"
environment  = "prod"

enable_frontend            = true
enable_auth                = true
enable_api                 = true
enable_cognito_auth_on_api = true
enable_hosted_ui           = true

# Optional Google federation (see root README)
# google_client_id     = ""
# google_client_secret = ""

lambda_zip_path = "../../../backend/dist/lambda.zip"

# Extra origins only — CloudFront is merged automatically.
# Add a custom domain here when you attach one to CloudFront.
cors_allow_origins = []

cognito_callback_urls = []

cognito_logout_urls = []

tags = {
  Owner = "platform"
}

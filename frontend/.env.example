# --- App ---
VITE_APP_NAME=AWS Web App Template
VITE_ENVIRONMENT=local

# --- API ---
# Local: http://localhost:8000
# Deployed: value of tofu output api_endpoint
VITE_API_BASE_URL=http://localhost:8000

# --- AWS Cognito (from tofu output) ---
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_USER_POOL_CLIENT_ID=
# Optional hosted UI domain prefix (only if enable_hosted_ui = true)
VITE_COGNITO_DOMAIN=

# --- Feature flags ---
VITE_ENABLE_AUTH=true
VITE_ENABLE_ANALYTICS=true

# --- PostHog (leave blank to no-op analytics) ---
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
